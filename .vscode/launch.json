    "version": "0.2.0",
    "configurations": [
        {
            "name": "Locations Service",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.services.locations.main:app",
                "--reload",
                "--host", "0.0.0.0",
                "--port", "9080"
            ],
            "jinja": true
        },
        {
            "name": "Members Service",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.services.members.main:app",
                "--reload",
                "--host", "0.0.0.0",
                "--port", "9081"
            ],
            "jinja": true
        },
        {
        "name": "Frontend",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "python",
        "args": ["-m","http.server","5500"],
        "cwd": "${workspaceFolder}/frontend"
        }        
    ]
}